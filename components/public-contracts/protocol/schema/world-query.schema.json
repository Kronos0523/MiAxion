{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.miaxion.dev/bridge/v1/world-query.schema.json",
  "$defs": {
    "registrySearchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "query",
        "pageSize"
      ],
      "properties": {
        "kind": {
          "enum": [
            "structure",
            "biome"
          ]
        },
        "query": {
          "type": "string",
          "maxLength": 512
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9_.-]{1,128}$"
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    },
    "registrySearchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "entries",
        "total"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/registryResolveResponse/properties/revision"
        },
        "entries": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/registryMatch"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    },
    "authority": {
      "enum": ["generator_located", "loaded_observed"]
    },
    "locatorRange": {
      "enum": ["near", "standard", "far"]
    },
    "chunkRange": {
      "enum": ["1x1", "3x3", "5x5"]
    },
    "verticalRange": {
      "enum": ["10", "50"]
    },
    "scanWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunkWidth", "verticalRadius"],
      "properties": {
        "chunkWidth": { "type": "integer", "enum": [1, 3, 5, 7, 9, 11, 13, 15] },
        "verticalRadius": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "pageCursor": { "type": "string", "pattern": "^(|[0-9a-f]{32})$", "maxLength": 32 },
    "nextCursor": { "type": "string", "pattern": "^[0-9a-f]{32}$", "minLength": 32, "maxLength": 32 },
    "continuationSummary": {
      "if": { "required": ["nextCursor"] },
      "then": { "properties": { "summary": { "properties": {
        "complete": { "const": false }, "truncated": { "const": true }
      } } } }
    },
    "registryKind": {
      "enum": ["structure", "biome"]
    },
    "targetKind": {
      "enum": ["metal_storage_block", "loot_container", "user_block"]
    },
    "machineState": {
      "enum": ["running", "idle", "blocked", "offline", "unknown"]
    },
    "machineFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:-]+$" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9_.:-]+$" },
        "value": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "capacity": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "resourceId": { "$ref": "common.schema.json#/$defs/resourceLocation" }
      }
    },
    "candidateDomain": {
      "enum": ["block_entity_only"]
    },
    "containerView": {
      "enum": ["full", "automation_unsided", "automation_sided", "loot_ungenerated", "locked", "unavailable"]
    },
    "warning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": -30000000, "maximum": 30000000 },
        "y": { "type": "number", "minimum": -2048, "maximum": 2048 },
        "z": { "type": "number", "minimum": -30000000, "maximum": 30000000 }
      }
    },
    "locateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "range"],
      "properties": {
        "targetId": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "range": { "$ref": "#/$defs/locatorRange" }
      }
    },
    "nearbyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunkRange", "verticalRange"],
      "properties": {
        "chunkRange": { "$ref": "#/$defs/chunkRange" },
        "verticalRange": { "$ref": "#/$defs/verticalRange" },
        "window": { "$ref": "#/$defs/scanWindow" },
        "pageCursor": { "$ref": "#/$defs/pageCursor" }
      }
    },
    "structureTargetsRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structureId": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "blockId": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "pageCursor": { "$ref": "#/$defs/pageCursor" }
      }
    },
    "registryResolveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "query"],
      "properties": {
        "kind": { "$ref": "#/$defs/registryKind" },
        "query": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "registryReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resourceId"],
      "properties": {
        "kind": { "$ref": "#/$defs/registryKind" },
        "resourceId": { "$ref": "common.schema.json#/$defs/resourceLocation" }
      }
    },
    "registryDescribeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registryReference" }
        }
      }
    },
    "warningList": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/warning" }
    },
    "querySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority", "dimensionId", "observedAtTick", "queryGeneration",
        "requested", "loaded", "examined", "matched", "complete", "truncated", "warnings"
      ],
      "properties": {
        "authority": { "$ref": "#/$defs/authority" },
        "dimensionId": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "observedAtTick": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "queryGeneration": { "type": "string", "minLength": 1, "maxLength": 64 },
        "requested": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "loaded": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "examined": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "matched": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "complete": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "warnings": { "$ref": "#/$defs/warningList" }
      }
    },
    "locatedResponse": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{
        "properties": {
          "summary": {
            "properties": {
              "authority": { "const": "generator_located" }
            }
          }
        }
      }],
      "required": ["summary", "targetId", "displayName", "x", "z", "y", "distanceBlocks", "radius", "queryCount"],
      "properties": {
        "summary": { "$ref": "#/$defs/querySummary" },
        "targetId": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "x": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
        "z": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
        "y": { "type": ["integer", "null"], "minimum": -2048, "maximum": 2048 },
        "distanceBlocks": { "type": "integer", "minimum": 0, "maximum": 30000000 },
        "radius": { "$ref": "#/$defs/locatorRange" },
        "queryCount": { "type": "integer", "minimum": 1, "maximum": 1024 }
      }
    },
    "machineObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "displayName", "position", "distanceBlocks", "adapterId", "candidateDomain", "state"],
      "properties": {
        "blockId": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "position": { "$ref": "#/$defs/position" },
        "distanceBlocks": { "type": "integer", "minimum": 0, "maximum": 30000000 },
        "adapterId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "candidateDomain": { "$ref": "#/$defs/candidateDomain" },
        "state": { "$ref": "#/$defs/machineState" },
        "features": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/machineFeature" }
        }
      }
    },
    "containerObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "displayName", "position", "distanceBlocks", "view"],
      "properties": {
        "blockId": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "position": { "$ref": "#/$defs/position" },
        "distanceBlocks": { "type": "integer", "minimum": 0, "maximum": 30000000 },
        "view": { "$ref": "#/$defs/containerView" }
      }
    },
    "targetObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "displayName", "position", "distanceBlocks", "kind", "priority"],
      "properties": {
        "targetId": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "position": { "$ref": "#/$defs/position" },
        "distanceBlocks": { "type": "integer", "minimum": 0, "maximum": 30000000 },
        "kind": { "$ref": "#/$defs/targetKind" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "registryMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resourceId", "translationKey", "displayName"],
      "properties": {
        "kind": { "$ref": "#/$defs/registryKind" },
        "resourceId": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "translationKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "machinesResponse": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/continuationSummary" }, {
        "properties": {
          "summary": {
            "properties": {
              "authority": { "const": "loaded_observed" }
            }
          }
        }
      }],
      "required": ["summary", "chunkRange", "verticalRange", "machines"],
      "properties": {
        "summary": { "$ref": "#/$defs/querySummary" },
        "chunkRange": { "$ref": "#/$defs/chunkRange" },
        "verticalRange": { "$ref": "#/$defs/verticalRange" },
        "machines": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/machineObservation" }
        },
        "window": { "$ref": "#/$defs/scanWindow" },
        "nextCursor": { "$ref": "#/$defs/nextCursor" }
      }
    },
    "containersResponse": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/continuationSummary" }, {
        "properties": {
          "summary": {
            "properties": {
              "authority": { "const": "loaded_observed" }
            }
          }
        }
      }],
      "required": ["summary", "chunkRange", "verticalRange", "containers"],
      "properties": {
        "summary": { "$ref": "#/$defs/querySummary" },
        "chunkRange": { "$ref": "#/$defs/chunkRange" },
        "verticalRange": { "$ref": "#/$defs/verticalRange" },
        "containers": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/containerObservation" }
        },
        "window": { "$ref": "#/$defs/scanWindow" },
        "nextCursor": { "$ref": "#/$defs/nextCursor" }
      }
    },
    "targetsResponse": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/continuationSummary" }, {
        "properties": {
          "summary": {
            "properties": {
              "authority": { "const": "loaded_observed" }
            }
          }
        }
      }],
      "required": ["summary", "structureId", "coverage", "targets"],
      "properties": {
        "summary": { "$ref": "#/$defs/querySummary" },
        "structureId": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "coverage": { "enum": ["structure_covered_chunks"] },
        "targets": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/targetObservation" }
        },
        "nextCursor": { "$ref": "#/$defs/nextCursor" }
      }
    },
    "registryResolveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "matches", "truncated"],
      "properties": {
        "revision": { "type": "string", "minLength": 1, "maxLength": 64 },
        "matches": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/registryMatch" }
        },
        "truncated": { "type": "boolean" },
        "suggestionsOnly": { "type": "boolean" }
      }
    },
    "registryDescribeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "descriptions", "missing"],
      "properties": {
        "revision": { "type": "string", "minLength": 1, "maxLength": 64 },
        "descriptions": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/registryMatch" }
        },
        "missing": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/registryReference" }
        }
      }
    },
    "progressResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "phase", "completedUnits", "totalUnits", "examined", "loaded"],
      "properties": {
        "active": { "type": "boolean" },
        "phase": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z][a-z0-9_.-]*$" },
        "completedUnits": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "totalUnits": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "examined": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "loaded": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      },
      "allOf": [
        {
          "if": { "properties": { "active": { "const": false } } },
          "then": {
            "properties": {
              "completedUnits": { "const": 0 },
              "totalUnits": { "const": 0 },
              "examined": { "const": 0 },
              "loaded": { "const": 0 }
            }
          }
        }
      ]
    }
  }
}
