{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.miaxion.dev/bridge/v1/extensions.schema.json",
  "$defs": {
    "descriptor": {
      "type": "object",
      "properties": {
        "extensionId": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$",
          "maxLength": 128
        },
        "extensionVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "maxLength": 32
        },
        "capabilityId": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
          "maxLength": 128
        },
        "capabilityVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "maxLength": 32
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "dataClass": {
          "const": "ExtensionGameData"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "capabilityId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "capabilityVersion": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$",
                "maxLength": 32
              }
            },
            "required": [
              "capabilityId",
              "capabilityVersion"
            ],
            "additionalProperties": false
          }
        },
        "executionContext": {
          "enum": [
            "client",
            "integrated-server"
          ]
        },
        "available": {
          "type": "boolean"
        },
        "unavailableReason": {
          "anyOf": [
            {
              "enum": [
                "DEPENDENCY_MISSING",
                "UNSUPPORTED_VERSION",
                "GAME_NOT_READY"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "maximumDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maximumResultBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      },
      "required": [
        "extensionId",
        "extensionVersion",
        "capabilityId",
        "capabilityVersion",
        "title",
        "description",
        "inputSchema",
        "outputSchema",
        "dataClass",
        "dependencies",
        "executionContext",
        "available",
        "unavailableReason",
        "maximumDurationMs",
        "maximumResultBytes"
      ],
      "additionalProperties": false
    },
    "listRequest": {
      "type": "object",
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "catalogRevision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "cursor",
        "catalogRevision"
      ],
      "additionalProperties": false
    },
    "listResponse": {
      "type": "object",
      "properties": {
        "worldScope": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "catalogRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capabilities": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/descriptor"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "catalogRevision",
        "capabilities",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "callRequest": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
          "maxLength": 128
        },
        "capabilityVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "maxLength": 32
        },
        "catalogRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "arguments": {
          "type": "object"
        }
      },
      "required": [
        "capabilityId",
        "capabilityVersion",
        "catalogRevision",
        "arguments"
      ],
      "additionalProperties": false
    },
    "callResponse": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "SUCCESS"
            },
            "data": {
              "type": "object"
            }
          },
          "required": [
            "status",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "UNAVAILABLE",
                "DEPENDENCY_MISSING",
                "UNSUPPORTED_VERSION",
                "INVALID_ARGUMENTS",
                "AUTHORITY_CHANGED",
                "RATE_LIMITED",
                "TIMED_OUT",
                "CANCELLED",
                "EXECUTION_FAILED",
                "UNSUPPORTED_RESULT",
                "RESULT_TOO_LARGE"
              ]
            },
            "data": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "data"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
