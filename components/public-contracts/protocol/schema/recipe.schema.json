{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.miaxion.dev/bridge/v1/recipe.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipes", "truncated"],
  "properties": {
    "resourceWarnings": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[A-Z0-9_]{1,64}$" } },
    "recipes": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/recipe" }
    },
    "truncated": { "type": "boolean" },
    "sourceComplete": { "type": "boolean" },
    "selectionComplete": { "type": "boolean" },
    "candidatesEvaluated": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "selectionMode": {
      "enum": ["recommended-direct", "recommended-process-families", "planning-direct"]
    },
    "inventoryRevision": { "type": "string", "minLength": 1, "maxLength": 64 },
    "selectionOrder": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/resourceLocation" }
    },
    "nextSourceCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+$"
    },
    "sourcePageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    }
  },
  "allOf": [
    {
      "if": { "required": ["nextSourceCursor"] },
      "then": { "required": ["sourcePageSize"] }
    }
  ],
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "resourceId",
        "ingredientTypeUid"
      ],
      "properties": {
        "kind": {
          "enum": [
            "item",
            "fluid",
            "chemical",
            "energy",
            "custom"
          ]
        },
        "resourceId": {
          "$ref": "common.schema.json#/$defs/resourceLocation"
        },
        "ingredientTypeUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "displayName": {
          "type": "string",
          "maxLength": 1024
        },
        "numerator": {
          "type": "string",
          "pattern": "^[0-9]{1,128}$",
          "not": { "pattern": "^0+$" }
        },
        "denominator": {
          "type": "string",
          "pattern": "^[0-9]{1,128}$",
          "not": {
            "pattern": "^0+$"
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "dependentRequired": {
        "numerator": [
          "denominator"
        ],
        "denominator": [
          "numerator"
        ]
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["itemId", "count"], "not": { "required": ["resource"] } },
        { "required": ["resource"], "not": { "anyOf": [{ "required": ["itemId"] }, { "required": ["count"] }] } }
      ],
      "properties": {
        "itemId": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "count": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "resource": { "$ref": "#/$defs/resource" },
        "components": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/resourceLocation" },
          "additionalProperties": true
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alternatives"],
      "properties": {
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "items": { "$ref": "#/$defs/alternative" }
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipeId",
        "type",
        "sourceModId",
        "identity",
        "inputs",
        "catalysts",
        "outputs"
      ],
      "properties": {
        "recipeId": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "type": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "sourceModId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_.-]+$"
        },
        "identity": { "$ref": "#/$defs/identity" },
        "inputs": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/slot" }
        },
        "catalysts": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/slot" }
        },
        "outputs": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/slot" }
        },
        "process": {
          "$ref": "#/$defs/process"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["identity"],
            "properties": {
              "identity": {
                "required": ["kind"],
                "properties": { "kind": { "const": "derived" } }
              }
            }
          },
          "then": {
            "properties": {
              "recipeId": {
                "type": "string",
                "pattern": "^miaxion:derived/[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "required": ["identity"],
            "properties": {
              "identity": {
                "required": ["kind"],
                "properties": { "kind": { "const": "registered" } }
              }
            }
          },
          "then": {
            "properties": {
              "recipeId": {
                "$ref": "common.schema.json#/$defs/resourceLocation"
              }
            }
          }
        }
      ]
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machineFamily"],
      "properties": {
        "machineFamily": { "$ref": "common.schema.json#/$defs/resourceLocation" },
        "durationTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "energyUnit": { "type": "string", "minLength": 1, "maxLength": 64 },
        "energyAmount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "dependentRequired": {
        "energyUnit": ["energyAmount"],
        "energyAmount": ["energyUnit"]
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "planningEligibility"],
      "properties": {
        "category": {
          "enum": ["crafting", "machine_processing", "drops", "loot", "conversion", "other_unclassified"]
        },
        "visibleCategoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "planningEligibility": {
          "enum": ["deterministic", "acquisition_only", "insufficient_data"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "category": { "enum": ["drops", "loot", "other_unclassified"] } }, "required": ["category"] },
          "then": { "properties": { "planningEligibility": { "enum": ["acquisition_only", "insufficient_data"] } } }
        }
      ]
    },
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "registered" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "algorithm", "contentSha256"],
          "properties": {
            "kind": { "const": "derived" },
            "algorithm": { "const": "sha256-canonical-v1" },
            "contentSha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
